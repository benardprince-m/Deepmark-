# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - never expose to client)
# Get this from Supabase project settings > API
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Configuration (REQUIRED - generate a random string 32+ characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-min-32-chars-here

# Application Settings
NEXT_PUBLIC_APP_NAME=DeepMark
NODE_ENV=development
